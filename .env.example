# StockPilot environment — copy to .env and fill in. NEVER commit .env.
# Exactly one LLM key is needed in Option B; Option A needs zero.

# --- LLM provider: gemini | groq | ollama ---
LLM_PROVIDER=gemini

# Option B (recommended): free key in 30s at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative free provider (https://console.groq.com)
GROQ_API_KEY=

# Option A (zero keys, offline): install Ollama + `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434/v1
# Override the provider default model if you want (defaults:
# gemini-2.5-flash / llama-3.3-70b-versatile / qwen2.5:7b)
LLM_MODEL=

# --- Database (zero setup; Postgres later by swapping DATABASE_URL) ---
DATABASE_URL=sqlite+aiosqlite:///./stockpilot.db

# --- Auth & crypto secrets (Phase 1+) ---
# openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Optional free push notifications ---
# ntfy.sh: any long random topic string acts as the password
NTFY_TOPIC=
# Telegram bot (via @BotFather) as an alternative
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 6 ONLY (optional live trading via Alpaca free account) ---
ALPACA_KEY=
ALPACA_SECRET=
